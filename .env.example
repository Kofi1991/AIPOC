# Copy to .env and fill in:  cp .env.example .env
#
# .env is gitignored and must stay that way — it holds a live admin session cookie and real
# credentials. This template carries names and comments only, never values.

# --- Environment under test ---------------------------------------------------
# Which site the suite runs against. Optional: defaults to staging
# (https://test.registertovote.london). Set it to https://release.registertovote.london for
# release, or use `./tools/run-tests.sh --release`. Production is refused outright by
# tests/helpers/siteConfig.js, since these specs create and delete content.
TC_BASE_URL=

# --- CMS admin account --------------------------------------------------------
# Required for the ~41 authenticated specs (the `content-admin` project). Public-site specs
# don't need them.
TC_ADMIN_USER=
TC_ADMIN_PASS=

# Session cookie for the admin account, reused instead of logging in per spec: the staging
# account allows one session at a time, so repeated logins evict each other. Required for the
# authenticated specs. Generate with `npm run session`, or paste one from a browser you're
# already logged into. Environment-specific — a staging cookie will not work on release — and
# expires after ~2 hours idle, at which point specs fail with "not a valid/live session".
TC_ADMIN_SESSION=

# --- Deliberately invalid login -----------------------------------------------
# A fake account that must NOT exist, used by the invalid-credentials spec to assert the
# login failure path. Required by that one spec.
TC_INVALID_USER=
TC_INVALID_PASS=

# --- TestCollab ---------------------------------------------------------------
# Numeric project id (the POC project is 18854). Required only by tools/file_jira_bugs.py,
# which stamps it on the bugs it files. The MCP server reads its own credentials from
# .mcp.json, not from here.
TC_DEFAULT_PROJECT=

# --- Jira (optional) ----------------------------------------------------------
# Only needed for `npm run test:jira`, which files a bug per failure that still reproduces.
# Leave blank and that step is simply skipped; nothing else depends on these.
JIRA_API_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- Evals (optional) ---------------------------------------------------------
# Used by the promptfoo eval of the agent prompts (see "Evals" in the README). Only needed to
# run that locally; CI reads it from a repository secret instead.
ANTHROPIC_API_KEY=

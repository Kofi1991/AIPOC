
# Secrets
.env
.env.*
# ...except the template, which is names and comments only and is meant to be tracked
!.env.example
.mcp.json

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Run-history screenshots/videos/traces — metadata (reports/run-history.json) stays
# tracked, but these binary artifacts would bloat the repo over many runs.
/reports/run-history-artifacts/

# MCP browser session snapshots/console logs (interactive exploration output)
/.playwright-mcp/

# Regenerable reports/output (tools/generate_report.py, tools/check-broken-links.js)
/reports/test-report.html
/reports/broken-links-report.json

# Stray root-level debug screenshots
/*.png

# One-off scratch output (link audits, experiment artifacts) — not source
/scratchpad/

# Python bytecode from tools/
__pycache__/
